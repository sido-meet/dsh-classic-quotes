{"id":"q-confucii-xuexi","text":"学而时习之，不亦说乎？","author":"孔子","work":"论语·学而","era":"先秦","topics":["学习","积累"],"mood":"steady","domain":["儒学"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-confucii-zhi","text":"知之者不如好之者，好之者不如乐之者。","author":"孔子","work":"论语·雍也","era":"先秦","topics":["学习","热爱"],"mood":"uplifting","domain":["儒学"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-confucii-gongju","text":"工欲善其事，必先利其器。","author":"孔子","work":"论语·卫灵公","era":"先秦","topics":["准备","专注"],"mood":"steady","domain":["儒学"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-confucii-sanren","text":"三人行，必有我师焉。","author":"孔子","work":"论语·述而","era":"先秦","topics":["学习","谦逊"],"mood":"steady","domain":["儒学"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-laozi-qianli","text":"千里之行，始于足下。","author":"老子","work":"道德经·第六十四章","era":"先秦","topics":["行动","专注"],"mood":"uplifting","domain":["道家"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-laozi-baobao","text":"合抱之木，生于毫末；九层之台，起于累土。","author":"老子","work":"道德经·第六十四章","era":"先秦","topics":["积累","行动"],"mood":"steady","domain":["道家"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-laozi-zhiren","text":"知人者智，自知者明。","author":"老子","work":"道德经·第三十三章","era":"先秦","topics":["自省"],"mood":"calm","domain":["道家"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-laozi-nanda","text":"天下难事，必作于易；天下大事，必作于细。","author":"老子","work":"道德经·第六十三章","era":"先秦","topics":["行动","专注"],"mood":"steady","domain":["道家"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-quyuan-lisao","text":"路漫漫其修远兮，吾将上下而求索。","author":"屈原","work":"离骚","era":"先秦","topics":["坚持","求索"],"mood":"uplifting","domain":["楚辞"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-quyuan-minsheng","text":"长太息以掩涕兮，哀民生之多艰。","author":"屈原","work":"离骚","era":"先秦","topics":["悲悯"],"mood":"intense","domain":["楚辞"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-libai-xinglu","text":"长风破浪会有时，直挂云帆济沧海。","author":"李白","work":"行路难·其三","era":"唐","topics":["挫折","乐观","远行"],"mood":"uplifting","domain":["唐诗"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-libai-jiangjiu","text":"天生我材必有用，千金散尽还复来。","author":"李白","work":"将进酒","era":"唐","topics":["自信","乐观"],"mood":"uplifting","domain":["唐诗"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-libai-nanling","text":"仰天大笑出门去，我辈岂是蓬蒿人。","author":"李白","work":"南陵别儿童入京","era":"唐","topics":["自信","志向"],"mood":"uplifting","domain":["唐诗"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-libai-xinghe","text":"醉后不知天在水，满船清梦压星河。","author":"李白","work":"题龙阳县青草湖","era":"唐","topics":["豁达","梦境"],"mood":"calm","domain":["唐诗"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-libai-lushan","text":"两水夹明镜，双桥落彩虹。","author":"李白","work":"望庐山瀑布","era":"唐","topics":["风景","豁达"],"mood":"calm","domain":["唐诗"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-wanganshi-dengfeifeng","text":"不畏浮云遮望眼，自缘身在最高层。","author":"王安石","work":"登飞来峰","era":"宋","topics":["视野","格局"],"mood":"uplifting","domain":["宋诗"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-wanganshi-bochuan","text":"春风又绿江南岸，明月何时照我还。","author":"王安石","work":"泊船瓜洲","era":"宋","topics":["思乡"],"mood":"calm","domain":["宋诗"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-sushi-dingfengbo","text":"回首向来萧瑟处，归去，也无风雨也无晴。","author":"苏轼","work":"定风波·莫听穿林打叶声","era":"宋","topics":["豁达","逆境"],"mood":"uplifting","domain":["宋词"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-sushi-zhangmang","text":"竹杖芒鞋轻胜马，谁怕？一蓑烟雨任平生。","author":"苏轼","work":"定风波·莫听穿林打叶声","era":"宋","topics":["豁达","逆境"],"mood":"uplifting","domain":["宋词"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-sushi-shuidiao","text":"人有悲欢离合，月有阴晴圆缺，此事古难全。","author":"苏轼","work":"水调歌头·明月几时有","era":"宋","topics":["豁达","接受"],"mood":"calm","domain":["宋词"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-sushi-futu","text":"腹有诗书气自华。","author":"苏轼","work":"和董传留别","era":"宋","topics":["积累","气质"],"mood":"steady","domain":["宋诗"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-luyou-youxishancun","text":"山重水复疑无路，柳暗花明又一村。","author":"陆游","work":"游山西村","era":"宋","topics":["坚持","转机"],"mood":"uplifting","domain":["宋诗"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-luyou-zhishang","text":"纸上得来终觉浅，绝知此事要躬行。","author":"陆游","work":"冬夜读书示子聿","era":"宋","topics":["实践","学习"],"mood":"steady","domain":["宋诗"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-luyou-bingqi","text":"位卑未敢忘忧国。","author":"陆游","work":"病起书怀","era":"宋","topics":["担当"],"mood":"steady","domain":["宋诗"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-xinqiji-chounuer","text":"青山遮不住，毕竟东流去。","author":"辛弃疾","work":"丑奴儿·书博山道中壁","era":"宋","topics":["不屈","执着"],"mood":"uplifting","domain":["宋词"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-xinqiji-qingyuan","text":"众里寻他千百度，蓦然回首，那人却在灯火阑珊处。","author":"辛弃疾","work":"青玉案·元夕","era":"宋","topics":["坚持","顿悟"],"mood":"calm","domain":["宋词"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-xinqiji-pozhenzi","text":"了却君王天下事，赢得生前身后名。","author":"辛弃疾","work":"破阵子·为陈同甫赋壮词以寄之","era":"宋","topics":["壮志","担当"],"mood":"intense","domain":["宋词"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-wangyangming-poshanzhong","text":"破山中贼易，破心中贼难。","author":"王守仁","work":"王阳明全集","era":"明","topics":["自省","意志","专注"],"mood":"steady","domain":["心学"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-wangyangming-zhixing","text":"知是行之始，行是知之成。","author":"王守仁","work":"传习录","era":"明","topics":["知行合一","行动"],"mood":"steady","domain":["心学"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-wangyangming-shishangmo","text":"人须在事上磨，方立得住。","author":"王守仁","work":"传习录","era":"明","topics":["实践","打磨"],"mood":"steady","domain":["心学"],"kind":"quote","verification":"curated","source":"chinese-poetry"}
{"id":"q-tagore-xiuhua","text":"生如夏花之绚烂，死如秋叶之静美。","author":"泰戈尔","work":"飞鸟集","era":"近现代","topics":["生命","自然"],"mood":"calm","domain":["诗歌"],"kind":"quote","verification":"curated","source":"wikiquote"}
{"id":"q-tagore-baoge","text":"世界以痛吻我，要报之以歌。","author":"泰戈尔","work":"飞鸟集","era":"近现代","topics":["韧性","希望"],"mood":"uplifting","domain":["诗歌"],"kind":"quote","verification":"curated","source":"wikiquote"}
{"id":"q-tagore-chibang","text":"天空没有留下翅膀的痕迹，但我已飞过。","author":"泰戈尔","work":"飞鸟集","era":"近现代","topics":["过程","不悔"],"mood":"uplifting","domain":["诗歌"],"kind":"quote","verification":"curated","source":"wikiquote"}
{"id":"q-nietzsche-shengren","text":"谁终将声震人间，必长久深自缄默。","author":"尼采","work":"查拉图斯特拉如是说","era":"近现代","topics":["耐心","积累"],"mood":"steady","domain":["哲学"],"kind":"quote","verification":"curated","source":"wikiquote"}
{"id":"q-nietzsche-shabusi","text":"那些杀不死我的，使我更强大。","author":"尼采","work":"偶像的黄昏","era":"近现代","topics":["韧性"],"mood":"intense","domain":["哲学"],"kind":"quote","verification":"curated","source":"wikiquote"}
{"id":"q-camus-longdong","text":"在隆冬，我终于知道，我身上有一个不可战胜的夏天。","author":"加缪","work":"夏天集","era":"近现代","topics":["韧性","希望"],"mood":"uplifting","domain":["哲学"],"kind":"quote","verification":"curated","source":"wikiquote"}
{"id":"q-camus-chuntian","text":"冬天来了，春天还会远吗？","author":"加缪","work":"西西弗神话","era":"近现代","topics":["希望","转机"],"mood":"uplifting","domain":["哲学"],"kind":"quote","verification":"curated","source":"wikiquote"}
{"id":"q-hemingway-laorenyu","text":"人可以被毁灭，但不能被打败。","author":"海明威","work":"老人与海","era":"近现代","topics":["坚韧","尊严"],"mood":"intense","domain":["小说"],"kind":"quote","verification":"curated","source":"wikiquote"}
